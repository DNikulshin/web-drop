{
  "name": "@web-drop/db",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "build": "pnpm exec tsc -p tsconfig.json && node -e \"require('fs').cpSync('src/generated', 'dist/generated', {recursive: true})\""
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@web-drop/tsconfig": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "copyfiles": "^2.4.1",
    "dotenv": "^17.4.2",
    "prisma": "^7.9.1",
    "typescript": "^7.0.2"
  }
}
